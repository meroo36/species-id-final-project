# Copy to .env and adjust. These are local development values only.
POSTGRES_USER=species
POSTGRES_PASSWORD=species
POSTGRES_DB=species_id
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Where images live on disk
DATA_DIR=data

# Frozen feature extractor (any timm model name)
EXTRACTOR=mobilenetv3_large_100.ra_in1k

# Ingestion
IMAGES_PER_TAXON=300
ALLOWED_LICENSES=cc0,cc-by,cc-by-nc

# Below this confidence a prediction is referred to human review
CONFIDENCE_THRESHOLD=0.6

# Scheduled pipeline: new photos fetched per taxon on each run
NEW_IMAGES_PER_RUN=20

# MLflow (host port 5001 because macOS uses 5000 for AirPlay)
MLFLOW_TRACKING_URI=http://localhost:5001

# Airflow web UI login (local development only)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Retrain when this many photos arrived since the production model was trained
RETRAIN_MIN_NEW_PHOTOS=1000

# Grafana web UI login (local development only)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
